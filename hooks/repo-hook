#!/bin/sh
# Device-specific repo sync hook — patches vendor before Soong runs
# A17-only: the 16.2 manifest branch does not carry this hook.

[ "$1" != "sync" ] && exit 0
[ -f "device/nothing/Spacewar/rootdir/bin/fix_vendor_a17.sh" ] || exit 0

echo "[repo-hook] Running fix_vendor_a17.sh..."
sh device/nothing/Spacewar/rootdir/bin/fix_vendor_a17.sh
