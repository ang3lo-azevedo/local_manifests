# Copy this to .env and fill in your values
# All fields are optional - you'll be prompted for any that are missing

# SSH connection to your ServerHive machine
SSH_CMD="ssh nos4a2250@arcane.serverhive.in -p22"
SSHPASS="your-password-here"

# Git cookie line from https://android.googlesource.com
GS_COOKIE="android.googlesource.com,FALSE,/,TRUE,2147483647,o,git-you=1//your-token-here"

# GitHub PAT (scope: repo) for private keys repo
GHPAT="ghp_your-token-here"

# Build folder name on the server
DIR="voltageos"

# Set this to skip cookie push after first run
# GS_COOKIE_SENT=1

# Set to 1 to skip terminfo push
# SKIP_TERMINFO=1
